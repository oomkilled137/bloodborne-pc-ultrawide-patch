+        ours = dict(writes)
+        changed = {SCENE_WIDTH, SCENE_HEIGHT, UI_WIDTH, UI_HEIGHT}
+        self.assertEqual({o: d for o, d in ours.items() if o not in changed},
+                         {o: d for o, d in community.items() if o not in changed | heap})
